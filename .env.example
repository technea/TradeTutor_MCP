# TradeTutor local configuration
TRADETUTOR_ENV=development
DEFAULT_SYMBOL=BTCUSDT
MAX_RISK_PERCENT=1

# Official Binance Agentic MCP endpoint.
# Authentication is handled by the connected MCP host; never put API keys here.
BINANCE_MCP_ENDPOINT=https://agent.binance.com/mcp/agentic

# Optional discovered tool overrides. Leave blank to use MCP discovery.
BINANCE_MCP_MARKET_TOOL=
BINANCE_MCP_ACCOUNT_TOOL=
BINANCE_MCP_ORDER_TOOL=
