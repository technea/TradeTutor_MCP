# TradeTutor local configuration
TRADETUTOR_ENV=development
DEFAULT_SYMBOL=BTCUSDT
MAX_RISK_PERCENT=1

# Binance MCP tool names are supplied by the connected authorized MCP runtime.
# Do not put API keys, secrets, seed phrases, or private keys in this file.
BINANCE_MCP_MARKET_TOOL=
BINANCE_MCP_ACCOUNT_TOOL=
BINANCE_MCP_ORDER_TOOL=
